# clangd configuration for this PlatformIO/xtensa project.
#
# compile_commands.json is generated by `pio run -t compiledb` and carries the real
# xtensa-esp32-elf-g++ command lines. clang cannot accept all of them: a handful of flags are
# GCC/xtensa-only, and clang aborts the driver invocation when it sees one. That matters more
# than it sounds -- when the driver invocation fails, clangd never learns the toolchain's
# system include paths either, so <stdio.h> and <vector> come back "file not found" and large
# parts of every file silently fail to parse. Cross-references inside those regions then
# appear to have no callers, which is exactly the wrong answer to be confident about.
#
# Removing the unsupported flags lets the driver query succeed; clangd then picks up the
# toolchain headers from the compiler named in the database.
CompileFlags:
  Remove:
    - -mlongcalls                    # xtensa call relocation, no clang equivalent
    - -mtext-section-literals        # xtensa literal placement
    - -mno-text-section-literals
    - -mfix-esp32-psram-cache-issue  # esp32 silicon workaround
    - -mfix-esp32-psram-cache-strategy=*
    - -fstrict-volatile-bitfields    # GCC-only
    - -fno-tree-switch-conversion    # GCC-only optimisation control
    - -fno-shrink-wrap
    - -freorder-blocks
    - -fno-reorder-blocks-and-partition
  Add:
    # Nothing here changes what is COMPILED -- the real build never sees this file. These
    # only stop clangd reporting diagnostics that are artefacts of parsing GCC code with
    # clang, which would otherwise bury the diagnostics that matter.
    - -Wno-unknown-warning-option
    - -Wno-unknown-attributes
    - -Wno-ignored-optimization-argument

Diagnostics:
  # The generated font/image tables are megabytes of numeric initialisers with no logic in
  # them; indexing them costs time and they produce nothing worth reading.
  Suppress:
    - drv_unknown_argument
    - drv_unknown_argument_with_suggestion
